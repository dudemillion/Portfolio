---
import { siteConfig } from "../config";
---

<header id="header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 sm:px-10 md:px-16 lg:px-24" aria-label="Primary navigation">
    <a
      href="#hero"
      class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-gray-950 text-sm font-bold text-white shadow-sm transition hover:bg-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700"
      aria-label="Nikhil Bhalla — back to top"
    >
      {siteConfig.shortName}
    </a>

    <ul class="flex items-center gap-4 text-xs font-bold text-gray-700 sm:gap-7 sm:text-sm">
      <li>
        <a class="transition hover:text-indigo-700" href="#projects">Projects</a>
      </li>
      <li class="hidden min-[420px]:block">
        <a class="transition hover:text-indigo-700" href="#about">About</a>
      </li>
      <li class="hidden sm:block">
        <a class="transition hover:text-indigo-700" href="#education">Education</a>
      </li>
      <li>
        <a
          class="rounded-lg border border-gray-300 bg-white/80 px-3 py-2 transition hover:border-indigo-300 hover:text-indigo-700"
          href={`mailto:${siteConfig.social.email}`}
        >Contact</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const updateHeader = () => {
    const header = document.getElementById("header");
    if (window.scrollY > 40) {
      header?.classList.add("bg-white/90", "backdrop-blur-md", "border-b", "border-gray-200/80");
    } else {
      header?.classList.remove("bg-white/90", "backdrop-blur-md", "border-b", "border-gray-200/80");
    }
  };

  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });
</script>
