---
import { siteConfig } from "../config";
---

<section id="about" class="px-6 py-20 sm:px-10 sm:py-24 md:px-16 lg:px-24">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4 lg:sticky lg:top-28">
        <p
          class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-indigo-700 sm:text-sm"
        >
          About
        </p>
        <h2
          class="text-4xl font-bold tracking-[-0.035em] text-gray-950 sm:text-5xl xl:text-6xl"
        >
          Curious by nature.<br />Practical by choice.
        </h2>
        <div
          class="mt-5 h-1.5 w-20 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        >
        </div>
      </div>

      <div class="space-y-10 lg:col-span-8">
        <div class="space-y-5">
          {
            siteConfig.about.map((paragraph, index) => (
              <p
                class:list={[
                  "leading-relaxed",
                  index === 0
                    ? "text-xl font-medium text-gray-800 sm:text-2xl md:text-3xl"
                    : "text-base text-gray-600 sm:text-lg md:text-xl",
                ]}
              >
                {paragraph}
              </p>
            ))
          }
        </div>

        <div class="grid gap-4 sm:grid-cols-3">
          {
            siteConfig.approach.map((item, index) => (
              <div class="rounded-2xl border border-gray-200 bg-gray-50 p-5">
                <span class="text-xs font-bold text-indigo-700">
                  0{index + 1}
                </span>
                <h3 class="mt-3 text-lg font-bold text-gray-950">{item.label}</h3>
                <p class="mt-2 text-sm leading-relaxed text-gray-600">
                  {item.text}
                </p>
              </div>
            ))
          }
        </div>

        <div>
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.16em] text-gray-500">
            Tools & technologies
          </p>
          <div class="flex flex-wrap gap-2.5">
            {
              siteConfig.skills.map((skill) => (
                <span class="rounded-full border border-gray-200 bg-white px-3.5 py-2 text-sm font-semibold text-gray-700 shadow-sm">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
