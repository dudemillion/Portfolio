---
import { siteConfig } from "../config";
---

<section
  id="hero"
  class="relative isolate flex min-h-[44rem] flex-col overflow-hidden bg-white"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div
    class="absolute inset-0 -z-20"
    style={`background: radial-gradient(ellipse 900px 900px at 4% 0%, ${siteConfig.accentColor}2f 0%, ${siteConfig.accentColor}17 35%, rgba(255,255,255,0) 72%)`}
  >
  </div>

  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full stroke-gray-200 [mask-image:linear-gradient(to_bottom,black,transparent_86%)]"
  >
    <defs>
      <pattern
        id="hero-grid"
        width="96"
        height="96"
        patternUnits="userSpaceOnUse"
      >
        <path d="M96 0H0V96" fill="none"></path>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-grid)" opacity="0.62"
    ></rect>
  </svg>

  <div
    class="mx-auto flex w-full max-w-7xl flex-1 items-center px-6 pb-14 pt-28 sm:px-10 md:px-16 md:pb-20 md:pt-36 lg:px-24"
  >
    <div class="max-w-5xl">
      <p
        class="animate-fade-in inline-flex max-w-full items-center gap-2 rounded-full border border-indigo-200 bg-white/80 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.12em] text-indigo-800 shadow-sm backdrop-blur sm:text-sm sm:tracking-[0.16em]"
      >
        <span class="h-2 w-2 rounded-full bg-indigo-600"></span>
        {siteConfig.hero.eyebrow}
      </p>

      <h1
        class="animation-delay-100 animate-fade-in mt-7 text-pretty text-5xl font-bold leading-[1.02] tracking-[-0.045em] text-gray-950 sm:text-6xl md:mt-9 md:text-7xl lg:text-8xl"
      >
        Hi, I'm <span style={{ color: siteConfig.accentColor }}
          >{siteConfig.name}</span
        >.
      </h1>

      <p
        class="animation-delay-200 animate-fade-in mt-7 max-w-4xl text-balance text-2xl font-semibold leading-snug text-gray-800 sm:text-3xl md:mt-9 md:text-4xl"
      >
        {siteConfig.hero.statement}
      </p>

      <p
        class="animation-delay-300 animate-fade-in mt-5 max-w-3xl text-pretty text-base leading-relaxed text-gray-600 sm:text-lg md:text-xl"
      >
        {siteConfig.hero.detail}
      </p>

      <div
        class="animation-delay-400 animate-fade-in mt-9 flex flex-col gap-3 sm:flex-row sm:items-center"
      >
        <a
          href="#projects"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-gray-950 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-gray-900/10 transition hover:-translate-y-0.5 hover:bg-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700 sm:text-base"
        >
          Explore my work
          <svg
            aria-hidden="true"
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-gray-300 bg-white/80 px-5 py-3 text-sm font-semibold text-gray-800 backdrop-blur transition hover:-translate-y-0.5 hover:border-gray-500 hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-indigo-700 sm:text-base"
        >
          View GitHub
          <svg
            aria-hidden="true"
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17 17 7M7 7h10v10"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div
    class="mx-auto flex w-full max-w-7xl flex-wrap items-center gap-x-6 gap-y-3 px-6 pb-8 text-sm font-medium text-gray-600 sm:px-10 md:px-16 lg:px-24"
  >
    <span class="text-gray-400">Connect</span>
    <a
      href={`mailto:${siteConfig.social.email}`}
      class="transition hover:text-indigo-700"
    >Email</a>
    <a
      href={siteConfig.social.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="transition hover:text-indigo-700"
    >LinkedIn</a>
    <a
      href={siteConfig.social.github}
      target="_blank"
      rel="noopener noreferrer"
      class="transition hover:text-indigo-700"
    >GitHub</a>
  </div>
</section>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.7s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-100 {
    animation-delay: 0.1s;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-300 {
    animation-delay: 0.3s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-fade-in {
      animation: none;
      opacity: 1;
    }
  }
</style>
