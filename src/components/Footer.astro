---
import { siteConfig } from "../config";
---

<footer class="border-t border-gray-200 bg-gray-50 px-6 py-12 sm:px-10 md:px-16 lg:px-24">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-2xl font-bold tracking-tight text-gray-950">{siteConfig.name}</p>
      <p class="mt-2 max-w-lg text-sm leading-relaxed text-gray-600 sm:text-base">
        {siteConfig.title} building thoughtful projects in machine learning, web development, and algorithms.
      </p>
      <div class="mt-5 flex flex-wrap gap-4 text-sm font-semibold text-gray-700">
        <a class="transition hover:text-indigo-700" href={`mailto:${siteConfig.social.email}`}>Email</a>
        <a class="transition hover:text-indigo-700" href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="transition hover:text-indigo-700" href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>

    <div class="flex flex-col gap-3 text-sm text-gray-500 md:items-end">
      <nav class="flex gap-5" aria-label="Footer navigation">
        <a class="transition hover:text-gray-950" href="#projects">Projects</a>
        <a class="transition hover:text-gray-950" href="#about">About</a>
        <a class="transition hover:text-gray-950" href="#education">Education</a>
      </nav>
      <p>© {new Date().getFullYear()} {siteConfig.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
