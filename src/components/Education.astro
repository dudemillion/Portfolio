---
import { siteConfig } from "../config";
---

<section id="education" class="px-6 py-20 sm:px-10 sm:py-24 md:px-16 lg:px-24">
  <div class="mx-auto max-w-7xl">
    <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-indigo-700 sm:text-sm">
          Education
        </p>
        <h2 class="text-4xl font-bold tracking-[-0.035em] text-gray-950 sm:text-5xl xl:text-6xl">
          Learning in and beyond the classroom.
        </h2>
        <div
          class="mt-5 h-1.5 w-20 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        >
        </div>
      </div>

      <div class="space-y-6 lg:col-span-8">
        {
          siteConfig.education.map((edu) => (
            <article class="rounded-3xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <p class="text-sm font-bold uppercase tracking-[0.12em] text-indigo-700">
                    {edu.program}
                  </p>
                  <h3 class="mt-2 break-words text-2xl font-bold tracking-tight text-gray-950 sm:text-3xl">
                    {edu.school}
                  </h3>
                </div>
                <span class="w-fit rounded-full bg-indigo-50 px-3 py-1.5 text-xs font-bold text-indigo-800 sm:text-sm">
                  {edu.dateRange}
                </span>
              </div>

              <p class="mt-5 max-w-3xl text-base leading-relaxed text-gray-600 sm:text-lg">
                {edu.summary}
              </p>

              <ul class="mt-7 grid gap-3 sm:grid-cols-3">
                {edu.achievements.map((achievement) => (
                  <li class="flex gap-3 rounded-2xl bg-gray-50 p-4 text-sm font-medium leading-relaxed text-gray-700">
                    <svg
                      aria-hidden="true"
                      class="mt-0.5 h-4 w-4 shrink-0 text-indigo-700"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                    >
                      <path d="m10 1.75 2.35 4.76 5.25.76-3.8 3.7.9 5.23-4.7-2.47-4.7 2.47.9-5.23-3.8-3.7 5.25-.76L10 1.75Z" />
                    </svg>
                    <span>{achievement}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
